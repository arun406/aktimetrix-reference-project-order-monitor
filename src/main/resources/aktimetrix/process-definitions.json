    "metrics": [
      { "code": "FUEL_PER_KM", "expression": "FUEL / DISTANCE", "unit": "L/KM", "tolerance": "10%", "worseWhen": "HIGHER" }
    ],
    "steps": [
      { "stepCode": "CONFIRM" },
      { "stepCode": "PAY" },
      { "stepCode": "HANDOVER" },
      { "stepCode": "ACCEPT" },
      { "stepCode": "TRAVEL" },
      { "stepCode": "DELIVERED" },
      { "stepCode": "RATED" }
    ]
  }
