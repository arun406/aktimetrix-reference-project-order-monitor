# Copy to .env (git-ignored) and fill in. Unset variables fall back to local defaults.

# MongoDB connection string, e.g. mongodb+srv://<user>:<password>@<cluster>/order-monitor
MONGODB_URI=mongodb://localhost:27017/order-monitor

# Kafka bootstrap servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Confluent Cloud only (with SPRING_PROFILES_ACTIVE=confluent)
# SPRING_PROFILES_ACTIVE=confluent
# KAFKA_API_KEY=
# KAFKA_API_SECRET=
